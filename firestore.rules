rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyKeysChanged(allowed) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowed);
    }

    function conversationParticipant(conv) {
      return signedIn() &&
        (conv.data.userId == request.auth.uid || conv.data.caregiverId == request.auth.uid);
    }

    function isValidBookingStatus(status) {
      return status == "Awaiting caregiver" ||
        status == "Pending" ||
        status == "Confirmed" ||
        status == "In Progress" ||
        status == "Completed" ||
        status == "Cancelled";
    }

    function isAllowedBookingTransition() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      let isPatient = resource.data.userId == request.auth.uid;
      let isCaregiver = resource.data.caregiverId == request.auth.uid;
      return isValidBookingStatus(to) && (
        // patient transitions
        (isPatient && (
          (from == "Awaiting caregiver" && to == "Cancelled") ||
          (from == "Pending" && to == "Cancelled") ||
          (from == "Confirmed" && to == "Cancelled") ||
          (from == "In Progress" && to == "Cancelled")
        )) ||
        // caregiver transitions
        (isCaregiver && (
          (from == "Awaiting caregiver" && to == "Confirmed") ||
          (from == "Pending" && to == "Confirmed") ||
          (from == "Awaiting caregiver" && to == "Cancelled") ||
          (from == "Pending" && to == "Cancelled") ||
          (from == "Confirmed" && to == "Cancelled") ||
          (from == "In Progress" && to == "Cancelled") ||
          (from == "Confirmed" && to == "In Progress") ||
          (from == "Confirmed" && to == "Completed") ||
          (from == "In Progress" && to == "Completed")
        ))
      );
    }

    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId) && request.resource.data.id == userId;
      allow update: if isUser(userId);
      allow delete: if isUser(userId);

      match /notifications/{notificationId} {
        allow read: if isUser(userId);
        allow create: if signedIn() &&
          request.resource.data.userId == userId &&
          request.resource.data.senderUserId == request.auth.uid;
        allow update, delete: if isUser(userId);
      }
    }

    match /caregivers/{caregiverId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() &&
        (resource == null || resource.data.userId == request.auth.uid) &&
        request.resource.data.userId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.caregiverId == request.auth.uid);

      // Emergency fallback: allow client creates when callables are unavailable.
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.status == "Awaiting caregiver" ||
         request.resource.data.status == "Pending");

      // Allow participant status + cancellation metadata updates.
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid || resource.data.caregiverId == request.auth.uid)
      ) &&
      resource.data.userId == request.resource.data.userId &&
      resource.data.caregiverId == request.resource.data.caregiverId &&
      onlyKeysChanged(["status", "cancellationRequestedByUid", "cancellationRequestedByRole", "cancellationRequestedAt"]) &&
      (
        // cancellation metadata only update
        request.resource.data.status == resource.data.status ||
        // status changed: enforce role-based transition matrix
        isAllowedBookingTransition()
      );

      allow delete: if false;
    }

    match /bookingAudits/{auditId} {
      allow read, write: if false;
    }

    match /connections/{connectionId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.caregiverId == request.auth.uid);

      allow create: if signedIn() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.caregiverId == request.auth.uid);

      allow update: if signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.caregiverId == request.auth.uid) &&
        onlyKeysChanged(["status"]);

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.caregiverId == request.auth.uid);

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.caregiverId is string;

      allow update: if signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.caregiverId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if signedIn() && conversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId))
        );

        allow create: if signedIn() && conversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId))
        ) &&
        request.resource.data.senderId == request.auth.uid;

        allow update: if signedIn() && conversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId))
        );

        allow delete: if false;
      }
    }

    match /familyMembers/{memberId} {
      allow read: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    function isMedicalRecordPatientOwner() {
      let pid = resource.data.patientId;
      return signedIn() && pid == request.auth.uid;
    }

    function isMedicalRecordFamilyMemberOwner() {
      let pid = resource.data.patientId;
      return signedIn() &&
        exists(/databases/$(database)/documents/familyMembers/$(pid)) &&
        get(/databases/$(database)/documents/familyMembers/$(pid)).data.ownerUserId == request.auth.uid;
    }

    function requestMedicalRecordPatientOwner() {
      let pid = request.resource.data.patientId;
      return signedIn() && pid == request.auth.uid;
    }

    function requestMedicalRecordFamilyMemberOwner() {
      let pid = request.resource.data.patientId;
      return signedIn() &&
        exists(/databases/$(database)/documents/familyMembers/$(pid)) &&
        get(/databases/$(database)/documents/familyMembers/$(pid)).data.ownerUserId == request.auth.uid;
    }

    function isCaregiverUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "caregiver";
    }

    match /medicalRecords/{recordId} {
      allow read: if signedIn() && (
        isMedicalRecordPatientOwner() ||
        isMedicalRecordFamilyMemberOwner() ||
        resource.data.caregiverId == request.auth.uid ||
        isCaregiverUser()
      );

      allow create: if signedIn() &&
        (requestMedicalRecordPatientOwner() ||
         requestMedicalRecordFamilyMemberOwner() ||
         request.resource.data.caregiverId == request.auth.uid ||
         isCaregiverUser());

      allow update, delete: if signedIn() &&
        (isMedicalRecordPatientOwner() ||
         isMedicalRecordFamilyMemberOwner() ||
         resource.data.caregiverId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
